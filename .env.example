# Copy to .env and adjust. All values have defaults.
HOST=127.0.0.1
PORT=3000
BASE_PATH=/
HOME_URL=/
# RDAP bootstrap redirector for client-side lookups. Optional: defaults to
# https://bootstrap.rcode3.com/rdap (baked into the wasm) when unset.
BOOTSTRAP_URL=https://bootstrap.rcode3.com/rdap
# RDAP "exts_list" media-type parameter for client-side lookups. Optional.
#   unset / empty        -> the library's default extension-id set
#   __none               -> omit the exts_list parameter entirely
#   default              -> the library's default extension-id set (explicit)
#   cidr0 jscontact ...  -> an explicit comma- and/or space-separated list of IANA ids
EXTS_LIST=
THEME=green_on_black
RUST_LOG=info
CORS_ORIGIN=*
CORS_METHODS=GET, POST, OPTIONS
CORS_HEADERS=Content-Type, Authorization
